  Source: {fileID: 4900000, guid: f9b7b53fa136dcb409ad648a8bed68c4, type: 3}
  Rows:
  - Index: 101
    PatternId: G1-01
    PhaseId: "G1-\uACF5\uD1B5"
    Name: "\uAD6C\uC2AC \uD68D\uB4DD \uD6C4 \uBB34\uB825\uD654"
    Category: "\uD30C\uD2F0 \uAE30\uBBF9"
    Shape: 
    Response: "\uD30C\uD2F0 \uAE30\uBBF9 \uC218\uD589"
    LinkedPatternId: 
    Confidence: "\uACF5\uAC1C \uACF5\uB7B5 \uCC38\uACE0"
    DamageTier: "\uC989\uC0AC\uAE09"
    DamageText: "\uC2E4\uD328 \uC2DC \uC804\uBA78(S1\xB7S2\xB7S11)"
    TelegraphTime: -1
    Recovery: -1
    AreaScale: -1
    Measured: 0
    Notes: "\uCCB4\uB825 30\uC904, 15~17\uC904 \uBD80\uADFC\uC5D0\uC11C \uAC01 1\uD68C
      \uBC1C\uC0DD. \uAD6C\uC2AC\uC744 \uC815\uD574 \uB454 \uC21C\uC11C\uB300\uB85C
      \uD68D\uB4DD\uD55C \uB4A4 \uBB34\uB825\uD654(\uC2A4\uD0DC\uAC70). \uAD6C\uC2AC\uC740
      \uBCF4\uC2A4\uB97C \uAE30\uC900\uC73C\uB85C 8\uBC29\uD5A5\uC5D0 \uBD89\uC740\uC0C9/\uD478\uB978\uC0C9\uC73C\uB85C
      \uC0DD\uC131(S1\xB7S4). \uC11C\uB85C \uB2E4\uB978 \uC0C9\uC744 \uBC88\uAC08\uC544
      \uD68D\uB4DD\uD574\uC57C \uD558\uBA70 \uAC19\uC740 \uC0C9\uC744 \uC5F0\uC18D\uC73C\uB85C
      \uBA39\uC73C\uBA74 \uC804\uBA78(S1\xB7S2\xB7S11). \uAD6C\uC2AC\uC774 \uBCF4\uC2A4\uC5D0
      \uB2FF\uC73C\uBA74 \uC2E4\uD328(S1\xB7S7). \uAD6C\uC2AC \uD68D\uB4DD \uC2DC
      \uB514\uBC84\uD504\uAC00 \uAC78\uB9AC\uBA70 \uB9CC\uB2A5\uC57D\uC774\uB098
      \uC815\uD654\uB85C \uD574\uC81C(S7\xB7S11). \uC5D0\uC2A4\uB354 '\uC6E8\uC774'\uB85C
      \uBB34\uB825\uD654\uB97C \uB300\uCCB4\uD558\uB294 \uBC29\uBC95\uC774 \uC788\uC74C(S1\xB7S2\xB7S3\xB7S4).
      \uCC38\uACE0 \uC6A9\uC5B4: \uACB0\uC18D."
  - Index: 102
    PatternId: G1-02
    PhaseId: G1-P1
    Name: "\uBC18\uB300 \uC0C9 \uBCF4\uC2A4 \uB09C\uC785"
    Category: "\uD30C\uD2F0 \uAE30\uBBF9"
    Shape: 
    Response: "\uD30C\uD2F0 \uAE30\uBBF9 \uC218\uD589"
    LinkedPatternId: 
    Confidence: "\uACF5\uAC1C \uACF5\uB7B5 \uCC38\uACE0"
    DamageTier: 
    DamageText: 
    TelegraphTime: -1
    Recovery: -1
    AreaScale: -1
    Measured: 0
    Notes: "\uBC1C\uB3D9 \uCCB4\uB825 \uAD6C\uAC04 \uBBF8\uD655\uC815. \uBC18\uB300
      \uC0C9 \uBCF4\uC2A4\uAC00 \uB09C\uC785\uD558\uBA74 \uB450 \uBCF4\uC2A4\uB97C
      \uC11C\uB85C \uBA40\uB9AC \uB5A8\uC5B4\uB728\uB824\uC57C \uD558\uBA70, \uAC00\uAE4C\uC6B0\uBA74
      \uD53C\uD574 \uAC10\uC18C \uBC84\uD504\uAC00 \uBD99\uC74C(S1\xB7S2\xB7S4).
      \uB09C\uC785 \uB300\uC751 \uBC84\uD504\uB97C \uAC00\uC9C4 \uD50C\uB808\uC774\uC5B4\uB9CC
      \uB09C\uC785 \uBCF4\uC2A4\uC5D0\uAC8C \uC720\uD6A8 \uD53C\uD574\uB97C \uC90C(S2\xB7S3\xB7S4).
      \uC77C\uC815 \uD53C\uD574\uB97C \uC8FC\uBA74 \uB09C\uC785 \uBCF4\uC2A4\uAC00
      \uBB3C\uB7EC\uB0A8(S1\xB7S2). \uCD5C\uC18C 2\uC778 \uC774\uC0C1 \uD544\uC694,
      \uC2F1\uAE00 \uBAA8\uB4DC\uC5D0\uB294 \uC5C6\uC74C(S7). \uCC38\uACE0 \uC6A9\uC5B4:
      \uB09C\uC785."
  - Index: 103
    PatternId: G1-03
    PhaseId: G1-P1
    Name: "\uCD94\uC801 \uD68C\uC624\uB9AC"
    Category: "\uD544\uB4DC \uC7A5\uD310"
    Shape: "\uC6D0"
    Response: 
    LinkedPatternId: 
    Confidence: "\uACF5\uAC1C \uACF5\uB7B5 \uCC38\uACE0"
    DamageTier: 
    DamageText: 
    TelegraphTime: -1
    Recovery: -1
    AreaScale: -1
    Measured: 0
    Notes: "\uB8E8\uAC00\uB8E8 \uAD6C\uAC04\uC5D0\uC11C \uC0AC\uC6A9. \uD0C0\uACA9
      \uBD88\uAC00 \uC0C1\uD0DC\uB85C \uC5B4\uADF8\uB85C \uB300\uC0C1\uC744 \uCC9C\uCC9C\uD788
      \uCD94\uC801\uD558\uB294 \uC6D0\uD615 \uD68C\uC624\uB9AC(S1\xB7S2\xB7S3). \uB300\uC751
      \uBC29\uC2DD\uC740 \uCD9C\uCC98 \uAC04 \uC0C1\uC774\uD558\uC5EC \uBBF8\uAE30\uC7AC."
  - Index: 104
    PatternId: G1-04
    PhaseId: G1-P3
    Name: "\uACF5\uD3EC \uD6C4 \uD6C4\uBC29 \uCC98\uD615"
    Category: "\uC2A4\uD0DC\uAC70 \uCCB4\uD06C"
    Shape: 
    Response: "\uC2A4\uD0DC\uAC70"
    LinkedPatternId: 
    Confidence: "\uACF5\uAC1C \uACF5\uB7B5 \uCC38\uACE0"
    DamageTier: "\uC989\uC0AC\uAE09"
    DamageText: "\uC2E4\uD328 \uC2DC \uC989\uC0AC\uAE09 \uD53C\uD574(S1), 2\uBC88
      \uC2E4\uD328\uD558\uBA74 \uC804\uBA78(S11)"
    TelegraphTime: -1
    Recovery: -1
    AreaScale: -1
    Measured: 0
    Notes: "\uCCB4\uB825 15~17\uC904 \uBD80\uADFC \uC774\uD6C4 \uD569\uCCB4 \uAD6C\uAC04\uC5D0\uC11C
      \uC0AC\uC6A9. \uBB34\uC791\uC704 1\uBA85\uC5D0\uAC8C \uACF5\uD3EC\uB97C \uAC74
      \uB4A4 \uADF8 \uB300\uC0C1 \uB4A4\uC5D0 \uB098\uD0C0\uB098 \uCC98\uD615\uC744
      \uC2DC\uB3C4\uD558\uBA70, \uC774\uB54C \uBB34\uB825\uD654(\uC2A4\uD0DC\uAC70)\uB85C
      \uC800\uC9C0(S1\xB7S3). \uACF5\uD3EC\uB97C \uBC18\uB4DC\uC2DC \uBB34\uB825\uD654\uB85C
      \uB04A\uC5B4\uC57C \uD558\uACE0 2\uBC88 \uC2E4\uD328\uD558\uBA74 \uC804\uBA78(S11).
      \uCD5C\uC18C 2\uC778 \uC774\uC0C1 \uD544\uC694, \uC2F1\uAE00 \uBAA8\uB4DC\uC5D0\uB294
      \uC5C6\uC74C(S7). \uC77C\uBD80 \uAE00\uC5D0\uC11C\uB294 '\uC554\uC2B5'\uC73C\uB85C
      \uD45C\uAE30."
  - Index: 105
    PatternId: G1-05
    PhaseId: G1-P0
    Name: "\uBCF4\uC2A4 \uBD84\uC5F4"
    Category: "\uD398\uC774\uC988 \uC804\uD658"
    Shape: 
    Response: "\uD574\uB2F9 \uC5C6\uC74C"
    LinkedPatternId: 
    Confidence: "\uACF5\uAC1C \uACF5\uB7B5 \uCC38\uACE0"
    DamageTier: 
    DamageText: 
    TelegraphTime: -1
    Recovery: -1
    AreaScale: -1
    Measured: 0
    Notes: "\uC911\uC559\uC5D0\uC11C \uCC44\uB110\uB9C1(\uD53C\uD574 \uAC10\uC18C
      90%, S3\xB7S4)\uD55C \uB4A4 \uB450 \uBCF4\uC2A4\uB85C \uBD84\uC5F4. \uBD84\uC5F4
      \uC911 \uBCF4\uC2A4 \uD0C0\uACA9 \uBD88\uAC00(S1\xB7S3\xB7S4). \uCCB4\uB825
      46\uC904 \uBD80\uADFC(S3\xB7S4\xB7S11, S1\xB7S2\uB294 45\uC904)."
  - Index: 201
    PatternId: G2-01
    PhaseId: G2-P1
    Name: "\uAC11\uC637 \uBD80\uC704\uD30C\uAD34 (\uB3CC\uC9C4 \uC720\uB3C4)"
    Category: "\uAE30\uBBF9"
    Shape: 
    Response: "\uD30C\uD2F0 \uAE30\uBBF9 \uC218\uD589"
    LinkedPatternId: G2-02
    Confidence: "\uACF5\uAC1C \uACF5\uB7B5 \uCC38\uACE0"
    DamageTier: 
    DamageText: 
    TelegraphTime: -1
    Recovery: -1
    AreaScale: -1
    Measured: 0
    Notes: "\uC2DC\uC791 \uC2DC \uD53C\uD574 \uAC10\uC18C(\uAC11\uC637) \uBC84\uD504
      2\uC911\uCCA9(S1\xB7S3). \uB3CC\uC9C4\uC744 \uC9C0\uD615 \uAD6C\uC870\uBB3C\uC5D0
      \uC801\uC911\uC2DC\uCF1C \uBCF4\uC2A4\uB97C \uADF8\uB85C\uAE30 \uC0C1\uD0DC\uB85C
      \uB9CC\uB4E0 \uB4A4 \uBD80\uC704 \uD30C\uAD34\uB85C \uC911\uCCA9\uC744 \uC81C\uAC70(S1\xB7S3\xB7S4).
      \uBD80\uC704 \uD30C\uAD34\uC6A9 \uD30C\uAD34 \uD3ED\uD0C4\uC774 \uD544\uC218(S6)."
  - Index: 202
    PatternId: G2-02
    PhaseId: G2-P1
    Name: "\uBC29\uC5B4 \uAD6C\uC2AC \uD68D\uB4DD"
    Category: "\uD30C\uD2F0 \uAE30\uBBF9"
    Shape: 
    Response: "\uD30C\uD2F0 \uAE30\uBBF9 \uC218\uD589"
    LinkedPatternId: G2-03
    Confidence: "\uACF5\uAC1C \uACF5\uB7B5 \uCC38\uACE0"
    DamageTier: 
    DamageText: 
    TelegraphTime: -1
    Recovery: -1
    AreaScale: -1
    Measured: 0
    Notes: "\uAD6C\uC870\uBB3C(\uCCA8\uD0D1) \uD30C\uAD34 \uD6C4 \uC0DD\uC131\uB418\uB294
      \uAD6C\uC2AC \uCD1D 8\uAC1C(\uAD6C\uC870\uBB3C\uB2F9 2\uAC1C). 1\uC778 1\uAC1C
      \uD68D\uB4DD\uD558\uBA74 \uC774\uD6C4 \uC989\uC0AC \uD328\uD134 1\uD68C\uB97C
      \uB9C9\uC544 \uC90C(S1\xB7S3\xB7S4). \uCC38\uACE0 \uC6A9\uC5B4: \uB85C\uB098\uC6B4\uC758
      \uAE30\uC6B4."
  - Index: 203
    PatternId: G2-03
